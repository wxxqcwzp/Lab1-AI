    "def build_model(pretrained=True):\n",
    "    weights = RegNet_Y_800MF_Weights.IMAGENET1K_V2 if pretrained else None\n",
    "    model = regnet_y_800mf(weights=weights)\n",
    "    model.fc = nn.Linear(model.fc.in_features, NUM_CLASSES)\n",
    "    return model.to(device)\n",
    "\n",
    "\n",
    "def train_one_epoch(model, loader, criterion, optimizer, scaler):\n",
    "    model.train()\n",
    "    total_loss = 0.0\n",
    "    preds_all, targets_all = [], []\n",
    "\n",
    "    for images, targets in tqdm(loader, desc=\"Обучение\", leave=False):\n",
    "        images = images.to(device, non_blocking=True)\n",
    "        targets = targets.to(device, non_blocking=True)\n",
    "\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "        with torch.amp.autocast(device.type, enabled=use_amp):\n",
    "            outputs = model(images)\n",
    "            loss = criterion(outputs, targets)\n",
    "\n",
    "        scaler.scale(loss).backward()\n",
    "        scaler.step(optimizer)\n",
    "        scaler.update()\n",
    "\n",
    "        total_loss += loss.item() * images.size(0)\n",
    "        preds_all.extend(outputs.argmax(1).cpu().numpy())\n",
    "        targets_all.extend(targets.cpu().numpy())\n",
    "\n",
    "    return total_loss / len(loader.dataset), accuracy_score(targets_all, preds_all)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def evaluate_model(model, loader, criterion):\n",
    "    model.eval()\n",
    "    total_loss = 0.0\n",
    "    preds_all, targets_all = [], []\n",
    "\n",
    "    for images, targets in tqdm(loader, desc=\"Проверка\", leave=False):\n",
    "        images = images.to(device, non_blocking=True)\n",
    "        targets = targets.to(device, non_blocking=True)\n",
    "\n",
    "        with torch.amp.autocast(device.type, enabled=use_amp):\n",
    "            outputs = model(images)\n",
    "            loss = criterion(outputs, targets)\n",
    "\n",
    "        total_loss += loss.item() * images.size(0)\n",
    "        preds_all.extend(outputs.argmax(1).cpu().numpy())\n",
    "        targets_all.extend(targets.cpu().numpy())\n",
    "\n",
    "    y_true = np.array(targets_all)\n",
    "    y_pred = np.array(preds_all)\n",
    "    return (\n",
    "        total_loss / len(loader.dataset),\n",
    "        accuracy_score(y_true, y_pred),\n",
    "        precision_score(y_true, y_pred, average=\"macro\", zero_division=0),\n",
    "        recall_score(y_true, y_pred, average=\"macro\", zero_division=0),\n",
    "        y_true,\n",
    "        y_pred\n",
    "    )\n",
    "\n",
    "\n",
    "def run_experiment(title, file_tag, pretrained, optimizer_cls):\n",
    "    print(f\"\\n{title}\")\n",
    "\n",
    "    torch.manual_seed(SEED)\n",
    "    model = build_model(pretrained=pretrained)\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    optimizer = optimizer_cls(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\n",
    "    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=NUM_EPOCHS)\n",
    "    scaler = torch.amp.GradScaler(device.type, enabled=use_amp)\n",
    "\n",
    "    history = {\"train_loss\": [], \"val_loss\": [], \"train_acc\": [], \"val_acc\": [], \"val_prec\": [], \"val_rec\": []}\n",
    "    best_val_acc = 0.0\n",
    "    weights_path = os.path.join(OUTPUT_DIR, f\"best_{file_tag}.pt\")\n",
    "    t0 = time.time()\n",
    "\n",
    "    for epoch in range(1, NUM_EPOCHS + 1):\n",
    "        tr_loss, tr_acc = train_one_epoch(model, train_loader, criterion, optimizer, scaler)\n",
    "        val_loss, val_acc, val_prec, val_rec, _, _ = evaluate_model(model, val_loader, criterion)\n",
    "        scheduler.step()\n",
    "\n",
    "        history[\"train_loss\"].append(tr_loss)\n",
    "        history[\"val_loss\"].append(val_loss)\n",
    "        history[\"train_acc\"].append(tr_acc)\n",
    "        history[\"val_acc\"].append(val_acc)\n",
    "        history[\"val_prec\"].append(val_prec)\n",
    "        history[\"val_rec\"].append(val_rec)\n",
    "\n",
    "        if val_acc > best_val_acc:\n",
    "            best_val_acc = val_acc\n",
    "            torch.save(model.state_dict(), weights_path)\n",
    "\n",
    "        print(\n",
    "            f\"Эпоха {epoch:2d}/{NUM_EPOCHS} | \"\n",
    "            f\"обучение: потери {tr_loss:.4f}, accuracy {tr_acc:.4f} | \"\n",
    "            f\"валидация: потери {val_loss:.4f}, accuracy {val_acc:.4f}, \"\n",
    "            f\"precision {val_prec:.4f}, recall {val_rec:.4f}\"\n",
    "        )\n",
    "\n",
    "    print(f\"Готово за {(time.time() - t0)/60:.1f} мин, лучшая accuracy: {best_val_acc:.4f}\")\n",
    "\n",
    "    with open(os.path.join(OUTPUT_DIR, f\"history_{file_tag}.json\"), \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(history, f, indent=2)\n",
    "\n",
    "    return history, weights_path"
   ]
  },
